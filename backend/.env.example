# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real credentials. Every value below is a placeholder.
#
# LOCAL (your laptop)      → backend/.env, built from this file.
# PRODUCTION (e.g. Render) → the host's Environment Variables screen, never a
#                            committed file. See "PRODUCTION" notes below.

# Server
PORT=8000
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# LOCAL: leave unset. PRODUCTION: set NODE_ENV=production on the host.
# This is more than cosmetic: in production, FRONTEND_URL and a complete
# email option (see Email below) become required — the server refuses to
# start if either is missing, rather than silently falling back to a
# localhost URL or logging password-reset links to the console instead of
# emailing them. Locally, if no email option is configured, reset links are
# printed in the backend terminal instead.
#
# FRONTEND_URL is also the base of every password-reset link — on a real
# deployment it must be the site's public address (e.g.
# https://your-shop.vercel.app), or links will point at localhost.
# NODE_ENV=production

# CORS allow-list — optional, comma-separated. Defaults to just
# FRONTEND_URL if unset, which is correct for a single-origin deployment.
# Only set this if you need to allow additional origins (e.g. preview
# deployment URLs) — FRONTEND_URL itself must stay a single URL, since it's
# also used to build the one canonical password-reset link.
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://preview.example.com

# Refresh-token cookie topology — optional, defaults to "lax". Leave unset
# for local dev and for same-site production (frontend/backend deployed as
# subdomains of one root domain). Set to "none" only if frontend and backend
# are deployed on genuinely different registrable domains in production —
# this automatically also forces the cookie's Secure flag on, since browsers
# require SameSite=None cookies to be Secure.
COOKIE_SAMESITE=lax

# Database — required. The server refuses to start without this.
DATABASE_URL="postgresql://username:password@host:5432/database?sslmode=require"

# Auth — required. The server refuses to start without this.
JWT_SECRET=your-super-secret-jwt-key

# ─────────────────────────────────────────────────────────────────────────
# Email — used by "Forgot Password". Without it, Staff and Admin can't
# receive their password-reset link (an Admin can still set a Staff
# password from Employee Management). All email values are backend-only —
# never prefix them with NEXT_PUBLIC_, never commit real ones, and ask the
# project owner for the shop's values privately (not in a group chat).
#
# The first COMPLETE option below is used, in this order:
#   1. Gmail API   2. Mailjet   3. Brevo   4. Gmail SMTP   5. Resend
#   (none → the email is printed in the backend terminal; local dev only)
#
# LOCAL:      Gmail SMTP (GMAIL_USER + GMAIL_APP_PASSWORD) is enough. The
#             Gmail API is optional locally.
# PRODUCTION: use the Gmail API. Render's free plan blocks outbound SMTP,
#             so Gmail SMTP cannot send from there.
# ─────────────────────────────────────────────────────────────────────────

# Gmail API (RECOMMENDED FOR PRODUCTION) — sends as the shop's real Gmail
# over HTTPS: free (~500/day), no domain needed, best inbox placement.
# Needs ALL FOUR of GMAIL_USER, GMAIL_CLIENT_ID, GMAIL_CLIENT_SECRET and
# GMAIL_REFRESH_TOKEN. If only some are set, production refuses to start
# (naming what's missing) and local dev prints a warning and falls back to
# the next option. One-time setup:
#   1. console.cloud.google.com → new project → enable "Gmail API".
#   2. Google Auth Platform → set up the consent screen (External), add the
#      shop's Gmail as a test user, then Audience → "Publish app" (refresh
#      tokens of apps left in "Testing" expire after 7 days).
#   3. Clients → Create client → type "Desktop app" → copy ID and secret.
#   4. Put GMAIL_USER, GMAIL_CLIENT_ID, GMAIL_CLIENT_SECRET in backend/.env,
#      then run `npm run gmail:token` in backend/ and paste the printed
#      token into GMAIL_REFRESH_TOKEN.
#   5. PRODUCTION: copy the same four values into the host's environment
#      variables. EMAIL_FROM is not needed — mail is sent as GMAIL_USER.
GMAIL_USER=yourshop@gmail.com
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Example formats:
#   GMAIL_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
#   GMAIL_CLIENT_SECRET=GOCSPX-your_client_secret
#   GMAIL_REFRESH_TOKEN=1//your_refresh_token

# Gmail SMTP via Nodemailer (RECOMMENDED FOR LOCAL) — reuses GMAIL_USER
# above. GMAIL_APP_PASSWORD is a 16-character Google App Password, NOT the
# normal Gmail password: Google Account → Security → 2-Step Verification →
# App passwords. Paste it without spaces. Needs outbound SMTP — works on
# most home/office networks, but NOT on Render.
GMAIL_APP_PASSWORD=abcdefghijklmnop

# ── Alternatives (optional; only if the Gmail options can't be used) ─────

# Mailjet — HTTPS, free (200/day), no domain needed. Add the shop's Gmail
# under Account Settings → Sender addresses & domains; keys are under
# Account Settings → API Key Management. Requires EMAIL_FROM (a verified
# Mailjet sender).
# MAILJET_API_KEY=your_mailjet_api_key
# MAILJET_SECRET_KEY=your_mailjet_secret_key

# Brevo — HTTPS, free (300/day), no domain needed. Verify the shop's Gmail
# under Senders; create a key under SMTP & API → API Keys. Requires
# EMAIL_FROM (a verified Brevo sender). Note: Brevo may hold mail sent from
# an @gmail.com sender (not DMARC-aligned).
# BREVO_API_KEY=xkeysib-your_brevo_api_key

# Resend — HTTPS. Get a key at resend.com/api-keys. EMAIL_FROM must be on a
# domain verified with Resend (onboarding@resend.dev only delivers to your
# own Resend account email).
# RESEND_API_KEY=re_your_resend_api_key

# Sender address for Mailjet, Brevo and Resend only (ignored by both Gmail
# options, which always send as GMAIL_USER).
# EMAIL_FROM=no-reply@yourdomain.com
