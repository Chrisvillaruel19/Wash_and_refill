# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real credentials. Every value below is a placeholder.

# Server
PORT=8000
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Set to "production" for a real deployment. This is more than cosmetic:
# in production, FRONTEND_URL/EMAIL_FROM/RESEND_API_KEY below all become
# required — the server refuses to start if any are missing, rather than
# silently falling back to a localhost URL or logging password-reset links
# to the console instead of emailing them. Leave unset for local development.
NODE_ENV=production

# CORS allow-list — optional, comma-separated. Defaults to just
# FRONTEND_URL if unset, which is correct for a single-origin deployment.
# Only set this if you need to allow additional origins (e.g. preview
# deployment URLs) — FRONTEND_URL itself must stay a single URL, since it's
# also used to build the one canonical password-reset link.
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://preview.example.com

# Refresh-token cookie topology — optional, defaults to "lax". Leave unset
# for local dev and for same-site production (frontend/backend deployed as
# subdomains of one root domain). Set to "none" only if frontend and backend
# are deployed on genuinely different registrable domains in production —
# this automatically also forces the cookie's Secure flag on, since browsers
# require SameSite=None cookies to be Secure.
COOKIE_SAMESITE=lax

# Database — required. The server refuses to start without this.
DATABASE_URL="postgresql://username:password@host:5432/database?sslmode=require"

# Auth — required. The server refuses to start without this.
JWT_SECRET=your-super-secret-jwt-key

# Email — RESEND_API_KEY is optional in development (unset = password-reset
# emails are logged to the console instead of actually being sent, so local
# dev works without a real key) but required in production. Get a key at
# resend.com/api-keys. Backend-only — never expose this to the frontend or
# prefix it with NEXT_PUBLIC_.
RESEND_API_KEY=re_your_resend_api_key
# Must be an email address on a domain you've verified with Resend (or
# onboarding@resend.dev for testing before you've verified your own domain).
EMAIL_FROM=your-email@yourdomain.com
