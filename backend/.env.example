# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real credentials. Every value below is a placeholder.

# Server
PORT=8000
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Database — required. The server refuses to start without this.
DATABASE_URL="postgresql://username:password@host:5432/database?sslmode=require"

# Auth — required. The server refuses to start without this.
JWT_SECRET=your-super-secret-jwt-key

# Email — optional. If any of these are unset, password-reset emails are
# logged to the console instead of actually being sent, so local dev works
# without real SMTP credentials. For Gmail: enable 2-Step Verification on
# the sending account, then generate an App Password at
# myaccount.google.com/apppasswords — SMTP_PASS is that 16-character App
# Password, never the account's real login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-gmail-app-password
EMAIL_FROM=your-email@gmail.com
