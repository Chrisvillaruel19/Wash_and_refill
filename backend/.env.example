# Copy this file to .env and fill in real values. .env is gitignored.

# Server
PORT=8000
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Database — required. The server refuses to start without this.
DATABASE_URL=postgresql://user:password@localhost:5432/wrlms

# Auth — required. The server refuses to start without this.
JWT_SECRET=replace-with-a-long-random-secret

# Email — optional. If any of these are unset, password-reset emails are
# logged to the console instead of actually being sent, so local dev works
# without real SMTP credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@wrlms.local
