# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real credentials. Every value below is a placeholder.

# Server
PORT=8000
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Set to "production" for a real deployment. This is more than cosmetic:
# in production, FRONTEND_URL and an email option (see Email below) become
# required — the server refuses to start if either is missing, rather than
# silently falling back to a localhost URL or logging password-reset links
# to the console instead of emailing them. Leave unset for local
# development (reset links are then printed in the backend terminal if no
# email option is configured).
#
# FRONTEND_URL is also the base of every password-reset link — on a real
# deployment it must be the site's public address (e.g.
# https://your-shop.vercel.app), or links will point at localhost.
NODE_ENV=production

# CORS allow-list — optional, comma-separated. Defaults to just
# FRONTEND_URL if unset, which is correct for a single-origin deployment.
# Only set this if you need to allow additional origins (e.g. preview
# deployment URLs) — FRONTEND_URL itself must stay a single URL, since it's
# also used to build the one canonical password-reset link.
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://preview.example.com

# Refresh-token cookie topology — optional, defaults to "lax". Leave unset
# for local dev and for same-site production (frontend/backend deployed as
# subdomains of one root domain). Set to "none" only if frontend and backend
# are deployed on genuinely different registrable domains in production —
# this automatically also forces the cookie's Secure flag on, since browsers
# require SameSite=None cookies to be Secure.
COOKIE_SAMESITE=lax

# Database — required. The server refuses to start without this.
DATABASE_URL="postgresql://username:password@host:5432/database?sslmode=require"

# Auth — required. The server refuses to start without this.
JWT_SECRET=your-super-secret-jwt-key

# ─────────────────────────────────────────────────────────────────────────
# Email — REQUIRED for "Forgot Password". Without it, Staff and Admin can't
# receive their password-reset link (an Admin can still set a Staff
# password from Employee Management). Configure ONE of the two options.
# ─────────────────────────────────────────────────────────────────────────

# Option 1 (default) — the shop's Gmail. Reset emails are sent FROM this
# account to any staff email address. Ask the project owner for the shop's
# values privately — never commit them or post them in a group chat.
#   GMAIL_USER         = the shop's Gmail address
#   GMAIL_APP_PASSWORD = a 16-character Google App Password, NOT the normal
#                        Gmail password. Create one at: Google Account →
#                        Security → 2-Step Verification → App passwords.
#                        Paste it without spaces.
# Needs outbound SMTP — works locally and on most hosts, but some (e.g.
# Render) block it; use Option 2 there instead.
GMAIL_USER=yourshop@gmail.com
GMAIL_APP_PASSWORD=abcdefghijklmnop

# Option 2 — Resend (only if Gmail can't be used, e.g. on Render). Leave
# GMAIL_USER/GMAIL_APP_PASSWORD unset when using this, since Gmail is
# always tried first when both are set. Get a key at resend.com/api-keys.
# Backend-only — never expose it to the frontend or prefix it with
# NEXT_PUBLIC_. EMAIL_FROM must be an address on a domain you've verified
# with Resend (onboarding@resend.dev only delivers to your own Resend
# account email). EMAIL_FROM is ignored when Gmail is used.
# RESEND_API_KEY=re_your_resend_api_key
# EMAIL_FROM=no-reply@yourdomain.com
