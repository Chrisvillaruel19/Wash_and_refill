// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


// login page
model User {
  id              String @id @default(uuid())

  username        String @unique
  email           String @unique
  password        String

  name            String
  phone           String?
  hiredDate       DateTime?

  role            Role @default(STAFF)
  accountStatus   AccountStatus @default(ACTIVE)

  orders          Order[]
  attendances     Attendance[]
  expenses        Expense[]
  shifts          ShiftHandover[]
  withdrawals     Withdrawal[]
  auditLogs       AuditLog[]
  tokens          Token[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum Role {
  STAFF
  ADMIN
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

// Token
model Token {
  id          String @id @default(uuid())

  userId      String
  user        User @relation(fields:[userId], references:[id], onDelete:Cascade)

  token       String @unique
  type        TokenType
  expiresAt   DateTime

  consumedAt  DateTime?
  revokedAt   DateTime?
}
enum TokenType {
  REFRESH
  VERIFY_EMAIL
  RESET_PASSWORD
}

// Customer Data
model Customer {
  id            String @id @default(uuid())

  customerName  String
  // Required + unique so order creation can always find-or-create a
  // customer by phone number without ever producing duplicate rows for
  // the same real person.
  phoneNumber   String @unique

  orders        Order[]

  createdAt     DateTime @default(now())
}

// new Order
model Order {
  id              String @id @default(uuid())

  customerId      String
  customer        Customer @relation(fields:[customerId], references:[id])

  userId          String
  user            User @relation(fields:[userId], references:[id])

  status          OrderStatus @default(PENDING)
  paymentStatus   PaymentStatus @default(UNPAID)
  paymentMethod   PaymentMethod?

  amountPaid      Decimal @default(0)
  totalAmount     Decimal

  paymentDate     DateTime?
  claimedDate     DateTime?

  orderDetails    OrderDetail[]
  consumptions    InventoryConsumption[]

  // Claim-based reconciliation: null means "not yet reconciled by any
  // Shift Handover." Set atomically, once, when a handover claims it —
  // never inferred from comparing timestamps.
  shiftHandoverId String?
  shiftHandover   ShiftHandover? @relation(fields: [shiftHandoverId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  READY
  CLAIMED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum PaymentMethod {
  CASH
  GCASH
}
// Order summary
model OrderDetail {
  id              String @id @default(uuid())

  orderId         String
  order           Order @relation(fields:[orderId], references:[id], onDelete:Cascade)

  serviceId       String?
  service         LaundryService? @relation(fields:[serviceId], references:[id])

  packageId       String?
  package         Package? @relation(fields:[packageId], references:[id])

  inventoryId     String?
  inventory       Inventory? @relation(fields:[inventoryId], references:[id])

  weight          Decimal?
  quantity        Int

  subtotal        Decimal
}

// Laundry Service catalog
model LaundryService {
  id          String @id @default(uuid())

  serviceName String
  itemType    ItemType

  price       Decimal
  status      Boolean @default(true)

  orderDetails OrderDetail[]
}

enum ItemType {
  CLOTHES
  HOUSEHOLD_ITEMS
  DRY_CLEAN_7_DAYS
  CARPET
  RUGS_AND_FLEECE_BLANKET
}

// Package catalog
model Package {
  id          String @id @default(uuid())

  packageName String
  price       Decimal
  color       String?

  status      Boolean @default(true)

  details     PackageDetail[]

  orderDetails OrderDetail[]
}

// Package details
model PackageDetail {
  id          String @id @default(uuid())

  packageId  String
  package    Package @relation(fields:[packageId], references:[id], onDelete:Cascade)

  inventoryId String
  inventory   Inventory @relation(fields:[inventoryId], references:[id])

  quantity    Int
}

// Inventory catalog
model Inventory {
  id          String @id @default(uuid())

  itemName    String

  quantity    Int
  unit        String

  unitPrice   Decimal

  // Per-item configurable threshold: quantity at or below this is "low
  // stock." Frontend's equivalent is InventoryItem.lowStockAlert.
  lowStockThreshold Int

  stockStatus StockStatus @default(IN_STOCK)

  // Soft-delete flag, matching Package/LaundryService's existing pattern.
  // "Deleting" an item sets this false instead of removing the row, so
  // historical OrderDetail/InventoryConsumption references never lose their
  // link to what was actually sold or consumed.
  isActive    Boolean @default(true)

  orderDetails OrderDetail[]
  packageDetails PackageDetail[]
  consumptions InventoryConsumption[]
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}
// Inventory consumption 
model InventoryConsumption {
  id          String @id @default(uuid())

  orderId     String
  order       Order @relation(fields:[orderId], references:[id], onDelete:Cascade)

  inventoryId String
  inventory   Inventory @relation(fields:[inventoryId], references:[id])

  quantityUsed Int

  createdAt DateTime @default(now())
}

// Attendance
model Attendance {
  id        String @id @default(uuid())

  userId    String
  user      User @relation(fields:[userId], references:[id], onDelete:Cascade)
  
  date      DateTime @db.Date
  timeIn    DateTime?
  timeOut   DateTime?

  // Stored, not recomputed later — clock-out freezes the real elapsed
  // hours; an auto-closed session freezes the capped ceiling instead (see
  // autoClosed below). Frontend's equivalent: AttendanceRecord.totalHours.
  totalHours Decimal?

  // True when the system closed this session automatically because it sat
  // clocked-in past the forgotten-clock-out threshold, rather than the
  // staff member actually clocking out. Kept visible, never hidden, so
  // Admin can spot and correct it for payroll. Frontend's equivalent:
  // AttendanceRecord.autoClosed.
  autoClosed Boolean @default(false)

  status    AttendanceStatus
  @@unique([userId,date])
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
}

// Expense
model Expense {
  id          String @id @default(uuid())

  userId      String
  user        User @relation(fields:[userId], references:[id])

  amount      Decimal
  category    ExpenseCategory

  description String
  receiptUrl  String?

  expenseDate DateTime

  shiftHandoverId String?
  shiftHandover   ShiftHandover? @relation(fields: [shiftHandoverId], references: [id])
}

enum ExpenseCategory {
  SUPPLIES_AND_MATERIALS
  UTILITIES
  EQUIPMENT_REPAIR
  RENT
  OTHER
}


// Shift Handover
model ShiftHandover {
  id              String @id @default(uuid())

  userId          String
  user            User @relation(fields:[userId], references:[id])

  startTime       DateTime
  endTime         DateTime

  laundryEarnings Decimal
  supplySales     Decimal
  customServiceSales Decimal @default(0)
  digitalSales    Decimal @default(0)
  expense         Decimal
  withdrawal      Decimal

  expectedBalance Decimal
  actualCashCount Decimal?

  cashStatus      CashStatus

  notes           String?

  // Claim-based reconciliation: the permanent, queryable record of exactly
  // which transactions this handover reconciled — an audit fact, not a
  // recomputation.
  claimedOrders      Order[]
  claimedExpenses    Expense[]
  claimedWithdrawals Withdrawal[]
}

enum CashStatus {
  BALANCED
  SHORTAGE
  EXCESS
}

// Withdrawal
model Withdrawal {
  id              String @id @default(uuid())

  userId          String
  user            User @relation(fields:[userId], references:[id])

  amount          Decimal
  reason          String
  remainingCash   Decimal
  // Full timestamp, not date-only: cash-reconciliation ordering (Shift
  // Handover/Withdrawal math) needs to compare this against other
  // timestamps precisely, including same-day cases.
  withdrawalDate  DateTime

  shiftHandoverId String?
  shiftHandover   ShiftHandover? @relation(fields: [shiftHandoverId], references: [id])
}

// Serialization point for the one shared cash drawer. Exactly one row
// exists (id = 1, seeded by migration — never created by application code).
// createShiftHandoverService and createWithdrawalService each acquire
// SELECT ... FOR UPDATE on this row as their first statement, before any
// other read, so the two operations that must agree on "what is the
// current state of the drawer" are fully serialized against each other.
// Order/Expense creation never touches this lock.
model DrawerState {
  id Int @id
}

// Auditlog
model AuditLog {
  id          String @id @default(uuid())

  userId      String
  user        User @relation(fields:[userId], references:[id])

  action      AuditAction

  module      String
  description String?

  oldValue    Json?
  newValue    Json?

  createdAt   DateTime @default(now())
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ARCHIVE
  RESTOCK
  WITHDRAWAL
  PAYMENT
  CLAIM
  LOGIN
  LOGOUT
  RESET_PASSWORD
}
